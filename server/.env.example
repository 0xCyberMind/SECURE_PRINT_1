# PrivPrint Server Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security (Generate with openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://privprint:privprint_pass@localhost:5432/privprint_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=privprint-documents
STORAGE_REGION=us-east-1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8888,https://secure-print-1.onrender.com,https://api.privprint.com
