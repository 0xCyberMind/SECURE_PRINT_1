# Copy to .env.production, restrict it to the deployment operator, and replace
# every placeholder using a secrets manager or generated secret values.
ENVIRONMENT=production
DEBUG=false
DEVELOPMENT_OTP_ENABLED=false
SECRET_KEY=REPLACE_WITH_A_UNIQUE_64_CHARACTER_HEX_SECRET

# Compose interpolates these to configure the database and Redis containers.
# Keep these URL-safe; `openssl rand -hex 32` generates suitable values.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_HEX_SECRET
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_HEX_SECRET

# Twilio Verify credentials are required by the production Compose stack.
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE_WITH_TWILIO_VERIFY_SERVICE_SID

# Use a TLS-protected S3-compatible production bucket, never MinIO defaults.
STORAGE_ENDPOINT=https://REPLACE_WITH_PRODUCTION_OBJECT_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY=REPLACE_WITH_PRODUCTION_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_PRODUCTION_STORAGE_SECRET_KEY
STORAGE_BUCKET_NAME=privprint-documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=true

CORS_ORIGINS=https://api.privprint.com
